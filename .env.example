# Harbor Registry URL (no trailing slash).
#   Examples:
#   - Self-hosted:  https://harbor.example.com
#   - On-prem:      https://harbor.internal.corp
HARBOR_URL=https://harbor.example.com

# Harbor username. Robot account ("robot$name") is strongly recommended
# so rotating the token doesn't impact interactive logins.
HARBOR_USERNAME=robot$your-robot

# Harbor password or robot-account token.
HARBOR_PASSWORD=your-password-or-robot-token

# Verify SSL certificates. Set to "false" for self-signed certs.
# Default: "true". Accepts: true/false/1/0/yes/no.
HARBOR_SSL_VERIFY=true
